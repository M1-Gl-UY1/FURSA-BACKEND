# ============================================================================
# FURSA Backend - Variables d'environnement
# ============================================================================
# Copier ce fichier en .env et remplir les vraies valeurs.
# NE JAMAIS committer le .env (il est dans .gitignore).
# ============================================================================

# --- Profil Spring ------------------------------------------------------------
# 'dev' en local (ddl-auto=update, logs DEBUG, DataSeeder actif)
# 'prod' en production (ddl-auto=validate, logs INFO, DataSeeder desactive)
SPRING_PROFILES_ACTIVE=dev

# --- Base de donnees PostgreSQL -----------------------------------------------
POSTGRES_DB=fursa
POSTGRES_USER=postgres
# OBLIGATOIRE - pas de valeur par defaut.
POSTGRES_PASSWORD=change_me

# --- JWT ---------------------------------------------------------------------
# OBLIGATOIRE, minimum 32 caracteres. Ne jamais reutiliser entre environnements.
# Generation : openssl rand -base64 48
JWT_SECRET=REPLACE_ME_WITH_openssl_rand_base64_48

# Duree du token en millisecondes (defaut 24h).
JWT_EXPIRATION_MS=86400000

# --- CORS --------------------------------------------------------------------
# Liste d'origines autorisees separees par des virgules.
# NE JAMAIS mettre * en prod (empeche les credentials).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Blockchain (Web3j) -------------------------------------------------------
# RPC du reseau cible (Sepolia testnet en prod, Hardhat en local).
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Adresse master du wallet FURSA (owner des contrats deployes).
BLOCKCHAIN_CONTRACT_ADDRESS=0x5b1869D9A4C187F2EAa108f3062412ecf0526b24
# OBLIGATOIRE en prod. JAMAIS de cle privee en clair dans le repo / chat.
BLOCKCHAIN_OWNER_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_GAS_PRICE=2000000000
BLOCKCHAIN_GAS_LIMIT=30000000

# --- Blockchain audit on-chain (Phases P + T) ---------------------------------
# Adresses des contrats singleton deployes sur Sepolia. Vides = no-op silencieux.
# Ne JAMAIS effacer une fois renseignees en prod (sinon perte du sync on-chain).
BLOCKCHAIN_REVENUE_LEDGER_ADDRESS=
BLOCKCHAIN_KYC_REGISTRY_ADDRESS=

# Sel secret pour le hash KYC RGPD-safe. Doit etre >= 32 chars.
# CRITIQUE : ne JAMAIS changer apres mise en service (sinon hashes historiques
# inverifiables = preuves d'audit perdues). Generer : openssl rand -hex 32.
KYC_ONCHAIN_SALT=
KYC_DUREE_VALIDITE_JOURS=365

# --- Email (Postal SMTP) ------------------------------------------------------
# Si MAIL_HOST est vide, le service tombe en log-only (pas d'envoi reel).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@fursa.seed-innov.com
MAIL_ENABLED=true
